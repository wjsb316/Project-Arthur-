# Arthur Prime — TEMPLATE ONLY (not read at runtime)
#
# The application loads settings from a file named `.env` in the working directory
# (see ap/config.py: env_file=".env"). This file is documentation; copy it to `.env`
# and put real secrets there. Never commit `.env`.
#
# Do not leave `KEY=` lines empty: either set a value, delete the line, or comment it out.
# (Empty values used to override defaults with blank strings and break startup.)

# Server
ARTHUR_APP_NAME=Arthur Prime
ARTHUR_HOST=0.0.0.0
ARTHUR_PORT=8000
ARTHUR_LOG_LEVEL=INFO

# Database paths (SQLite)
ARTHUR_AUDIT_DB_PATH=audit.db
ARTHUR_PROFESSIONAL_DB_PATH=professional.db
ARTHUR_MEMORY_DB_PATH=memory.db
ARTHUR_USERS_DB_PATH=users.db

# LLM provider (xAI or OpenAI — same OpenAI-compatible chat/completions API)
# Use either ARTHUR_XAI_KEY (xAI) or ARTHUR_OPENAI_API_KEY (OpenAI) for the chat model key.
# Legacy: `XAI_KEY=...` (no ARTHUR_ prefix) is also read for the chat key.
ARTHUR_XAI_KEY=your-xai-key-here
# ARTHUR_OPENAI_API_KEY=your-openai-key-here
ARTHUR_OPENAI_BASE_URL=https://api.x.ai/v1
# For OpenAI: ARTHUR_OPENAI_BASE_URL=https://api.openai.com/v1
ARTHUR_OPENAI_MODEL=grok-4-fast-reasoning

# Voice / TTS (OpenAI audio API). If you use api.openai.com for chat, you may omit this
# and the app will reuse ARTHUR_OPENAI_API_KEY for TTS.
ARTHUR_OPENAI_TTS_API_KEY=your-openai-key-here
ARTHUR_OPENAI_TTS_MODEL=gpt-4o-mini-tts
ARTHUR_OPENAI_TTS_VOICE=coral
# ARTHUR_OPENAI_TTS_INSTRUCTIONS=
# Set to true to skip TTS synthesis and return JSON (debug mode)
ARTHUR_SKIP_SPEECH_SYNTHESIS=false

# Optional: override the voice conversation system prompt
# ARTHUR_VOICE_SYSTEM_PROMPT=

# Optional: path to a JSON config file (overrides env vars for those keys)
# ARTHUR_CONFIG_FILE=
