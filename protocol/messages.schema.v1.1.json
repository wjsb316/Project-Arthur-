{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Arthur AP Protocol v1.1",
  "type": "object",
  "required": ["id", "type", "timestamp", "payload"],
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "type": {"type": "string", "enum": ["speech", "tool"]},
    "timestamp": {"type": "string", "format": "date-time"},
    "stream": {"type": "boolean", "default": true},
    "delta_index": {"type": "integer", "minimum": 0},
    "complete": {"type": "boolean"},
    "ack": {"type": "boolean"},
    "payload": {
      "type": "object",
      "properties": {
        "text": {"type": "string"},
        "name": {"type": "string"},
        "args": {"type": "object", "additionalProperties": true},
        "sensitive": {"type": "boolean", "default": false}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {"properties": {"type": {"const": "speech"}}},
      "then": {"properties": {"payload": {"required": ["text"]}}}
    },
    {
      "if": {"properties": {"type": {"const": "tool"}}},
      "then": {"properties": {"payload": {"required": ["name"]}}}
    }
  ]
}
